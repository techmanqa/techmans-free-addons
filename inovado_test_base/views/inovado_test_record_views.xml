<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inovado_test_record_list" model="ir.ui.view">
        <field name="name">inovado.test.record.list</field>
        <field name="model">inovado.test.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="base_note"/>
            </list>
        </field>
    </record>

    <record id="view_inovado_test_record_form" model="ir.ui.view">
        <field name="name">inovado.test.record.form</field>
        <field name="model">inovado.test.record</field>
        <field name="arch" type="xml">
            <form string="Test Record">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="base_note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_inovado_test_record" model="ir.actions.act_window">
        <field name="name">Test Records</field>
        <field name="res_model">inovado.test.record</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_inovado_test_root" name="Inovado Test" sequence="90"/>
    <menuitem id="menu_inovado_test_records"
              name="Test Records"
              parent="menu_inovado_test_root"
              action="action_inovado_test_record"
              sequence="10"/>
</odoo>
