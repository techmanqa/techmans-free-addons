<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_template_form_inherit_margin_fields" model="ir.ui.view">
        <field name="name">product.template.form.inherit.margin.fields</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Inject just after the div containing standard_price -->
            <xpath expr="//div[field[@name='standard_price']]" position="after">
                <label for="markup_percent"/>
                <div class="o_row">
                    <field name="markup_percent" class="oe_inline"/>
                </div>
                <label for="total_markup"/>
                <div class="o_row">
                    <field name="total_markup" class="oe_inline" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
