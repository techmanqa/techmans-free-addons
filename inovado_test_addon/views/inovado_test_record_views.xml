<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inovado_test_record_form_addon" model="ir.ui.view">
        <field name="name">inovado.test.record.form.addon</field>
        <field name="model">inovado.test.record</field>
        <field name="inherit_id" ref="inovado_test_base.view_inovado_test_record_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="addon_note"/>
            </field>
        </field>
    </record>

    <record id="view_inovado_test_record_list_addon" model="ir.ui.view">
        <field name="name">inovado.test.record.list.addon</field>
        <field name="model">inovado.test.record</field>
        <field name="inherit_id" ref="inovado_test_base.view_inovado_test_record_list"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="addon_note"/>
            </field>
        </field>
    </record>
</odoo>
