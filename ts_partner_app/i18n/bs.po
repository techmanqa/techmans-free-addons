#. module: ts_partner_app
#: model:mail.template,body_html:ts_partner_app.mail_template_asset_expiry_client
msgid ""
"<div style=\"margin:0px;padding:0px;font-size:14px;\">\n"
"    <p>Hello <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"    <p>\n"
"        This is a reminder that your\n"
"        <strong t-out=\"dict(object._fields['type']._description_selection(object.env)).get(object.type, object.type)\"/>\n"
"        <strong t-out=\"object.name\"/> is due to expire on\n"
"        <strong t-out=\"object.end_date or ''\"/>.\n"
"    </p>\n"
"    <p>\n"
"        Please get in touch or let us know if you'd like to renew, so we can make sure\n"
"        there's no interruption to your service.\n"
"    </p>\n"
"    <p>\n"
"        <a t-attf-href=\"#{object.get_base_url()}/my/assets/#{object.id}\" style=\"background-color:#875A7B;color:#ffffff;padding:8px 16px;text-decoration:none;border-radius:3px;\">\n"
"            View &amp; Request Renewal\n"
"        </a>\n"
"    </p>\n"
"    <p>Thank you for your business.</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0px;padding:0px;font-size:14px;\">\n"
"    <p>Zdravo <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"    <p>\n"
"        Ovo je podsjetnik da vaš\n"
"        <strong t-out=\"dict(object._fields['type']._description_selection(object.env)).get(object.type, object.type)\"/>\n"
"        <strong t-out=\"object.name\"/> ističe\n"
"        <strong t-out=\"object.end_date or ''\"/>.\n"
"    </p>\n"
"    <p>\n"
"        Molimo javite nam se ako želite obnoviti, kako bismo osigurali\n"
"        da nema prekida vaše usluge.\n"
"    </p>\n"
"    <p>\n"
"        <a t-attf-href=\"#{object.get_base_url()}/my/assets/#{object.id}\" style=\"background-color:#875A7B;color:#ffffff;padding:8px 16px;text-decoration:none;border-radius:3px;\">\n"
"            Pregledaj i zatraži obnovu\n"
"        </a>\n"
"    </p>\n"
"    <p>Hvala vam na povjerenju.</p>\n"
"</div>\n"
"            "

