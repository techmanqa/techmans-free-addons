#. module: ts_partner_app
#: model:mail.template,body_html:ts_partner_app.mail_template_asset_expiry
msgid ""
"<div style=\"margin:0px;padding:0px;font-size:14px;\">\n"
"    <p>Hello <t t-out=\"object.user_id.name or ''\"/>,</p>\n"
"    <p>\n"
"        The asset <strong t-out=\"object.name\"/>\n"
"        (<t t-out=\"dict(object._fields['type']._description_selection(object.env)).get(object.type, object.type)\"/>)\n"
"        for customer <strong t-out=\"object.partner_id.name or ''\"/> is approaching its end date.\n"
"    </p>\n"
"    <ul>\n"
"        <li>End date: <t t-out=\"object.end_date or ''\"/></li>\n"
"        <li>Monthly billing: <t t-out=\"object.monthly_billing_client or 0\"/> <t t-out=\"object.currency_id.name or ''\"/></li>\n"
"    </ul>\n"
"    <p>Please handle the renewal in time.</p>\n"
"</div>\n"
msgstr ""
"<div style=\"margin:0px;padding:0px;font-size:14px;\">\n"
"    <p>Zdravo <t t-out=\"object.user_id.name or ''\"/>,</p>\n"
"    <p>\n"
"        Sredstvo <strong t-out=\"object.name\"/>\n"
"        (<t t-out=\"dict(object._fields['type']._description_selection(object.env)).get(object.type, object.type)\"/>)\n"
"        za klijenta <strong t-out=\"object.partner_id.name or ''\"/> se približava svom krajnjem datumu.\n"
"    </p>\n"
"    <ul>\n"
"        <li>Krajnji datum: <t t-out=\"object.end_date or ''\"/></li>\n"
"        <li>Mjesečno fakturisanje: <t t-out=\"object.monthly_billing_client or 0\"/> <t t-out=\"object.currency_id.name or ''\"/></li>\n"
"    </ul>\n"
"    <p>Molimo obradite obnovu na vrijeme.</p>\n"
"</div>\n"

