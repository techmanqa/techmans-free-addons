<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: starting catalog. New platforms are added from
         Configuration > Environment Platforms; edits/removals here are not
         overwritten on upgrade. -->
    <data noupdate="1">
        <record id="env_platform_odoo_sh" model="partner.environment.platform">
            <field name="name">Odoo.sh</field>
            <field name="kind">odoo_sh</field>
            <field name="sequence">10</field>
            <field name="show_infrastructure" eval="False"/>
        </record>
        <record id="env_platform_oec_sh" model="partner.environment.platform">
            <field name="name">OEC.sh</field>
            <field name="kind">oec_sh</field>
            <field name="sequence">20</field>
        </record>
        <record id="env_platform_docker" model="partner.environment.platform">
            <field name="name">Docker</field>
            <field name="kind">docker</field>
            <field name="sequence">30</field>
        </record>
        <record id="env_platform_odoo_online" model="partner.environment.platform">
            <field name="name">Odoo Online</field>
            <field name="kind">odoo_online</field>
            <field name="sequence">40</field>
            <field name="show_infrastructure" eval="False"/>
        </record>
        <record id="env_platform_custom" model="partner.environment.platform">
            <field name="name">Custom Server</field>
            <field name="kind">custom</field>
            <field name="sequence">50</field>
        </record>
    </data>
</odoo>
