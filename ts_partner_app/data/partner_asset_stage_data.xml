<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="stage_new" model="partner.asset.stage">
            <field name="name">New</field>
            <field name="sequence">5</field>
            <field name="description">Client has just signed — asset not provisioned/live yet.</field>
            <field name="color">4</field>
        </record>

        <record id="stage_running" model="partner.asset.stage">
            <field name="name">Running</field>
            <field name="sequence">10</field>
        </record>

        <record id="stage_to_renew" model="partner.asset.stage">
            <field name="name">To Renew</field>
            <field name="sequence">20</field>
        </record>

        <record id="stage_closed" model="partner.asset.stage">
            <field name="name">Closed</field>
            <field name="sequence">30</field>
            <field name="fold" eval="False"/>
        </record>
    </data>
</odoo>
