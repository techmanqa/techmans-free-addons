<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_partner_asset_health_check" model="ir.cron">
            <field name="name">Partner Asset: SSL &amp; Uptime Health Check</field>
            <field name="model_id" ref="model_partner_asset"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_asset_health()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_partner_asset_weekly_digest" model="ir.cron">
            <field name="name">Partner Asset: Weekly Manager Digest</field>
            <field name="model_id" ref="model_partner_asset"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_weekly_digest()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
