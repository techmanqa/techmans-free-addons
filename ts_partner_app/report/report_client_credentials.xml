<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_client_credentials" model="ir.actions.report">
        <field name="name">Credentials</field>
        <field name="model">partner.asset</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ts_partner_app.report_client_credentials</field>
        <field name="report_file">ts_partner_app.report_client_credentials</field>
        <field name="binding_model_id" ref="model_partner_asset"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Client Credentials'</field>
        <field name="group_ids" eval="[(6, 0, [ref('group_partner_asset_manager')])]"/>
    </record>

    <template id="report_client_credentials">
        <t t-call="web.html_container">
            <t t-foreach="docs.mapped('partner_id')" t-as="partner">
                <t t-set="partner_assets" t-value="docs.filtered(lambda a: a.partner_id == partner)"/>
                <t t-set="infra" t-value="partner.env['partner.infrastructure'].search([('partner_id', '=', partner.id)], limit=1)"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="alert alert-danger" role="alert">
                            <strong>Restricted document.</strong> Contains live credentials. Managers only —
                            do not forward or store outside a secure location.
                        </div>
                        <h2>Client Credentials</h2>
                        <h4 t-out="partner.name"/>
                        <p class="text-muted">
                            Generated on <span t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                            by <span t-out="env.user.name"/>
                        </p>

                        <!-- ================= Infrastructure Profile ================= -->
                        <t t-if="infra">
                            <t t-if="infra.odoo_login_password or infra.github_token"
                               t-set="_log" t-value="infra._log_credential_action('reveal', 'credentials_report')"/>
                            <h3 class="mt-4">Infrastructure Profile</h3>
                            <table class="table table-sm mt-2">
                                <tr t-if="infra.odoo_login_url or infra.odoo_login_email or infra.odoo_login_password">
                                    <td style="width:220px;"><strong>Odoo Login</strong></td>
                                    <td>
                                        <span t-out="infra.odoo_login_url or '-'"/><br/>
                                        <span class="text-muted">User:</span> <span t-out="infra.odoo_login_email or '-'"/><br/>
                                        <span class="text-muted">Password:</span>
                                        <span t-out="infra.odoo_login_password or '-'" style="font-family:monospace;"/>
                                    </td>
                                </tr>
                                <tr t-if="infra.github_url or infra.github_token">
                                    <td><strong>GitHub</strong></td>
                                    <td>
                                        <span t-out="infra.github_url or '-'"/>
                                        (<span t-out="infra.github_branch or 'main'"/>)<br/>
                                        <span class="text-muted">Access Token:</span>
                                        <span t-out="infra.github_token or '-'" style="font-family:monospace;"/>
                                    </td>
                                </tr>
                                <tr t-if="infra.hosting_type == 'custom_server'">
                                    <td><strong>Server SSH</strong></td>
                                    <td>
                                        <span t-out="'%s@%s:%s' % (infra.server_ssh_user or '-', infra.server_host or '-', infra.server_ssh_port or '-')"/>
                                    </td>
                                </tr>
                            </table>
                        </t>
                        <div t-if="not infra" class="text-muted mt-3">
                            No Infrastructure Profile configured for this client.
                        </div>

                        <!-- ================= Per-asset legacy credentials ================= -->
                        <t t-set="assets_with_creds" t-value="partner_assets.filtered(lambda a: a.password or a.password2)"/>
                        <t t-if="assets_with_creds">
                            <h3 class="mt-4">Asset Logins</h3>
                            <table class="table table-sm mt-2">
                                <thead>
                                    <tr>
                                        <th>Asset</th>
                                        <th>URL</th>
                                        <th>Username</th>
                                        <th>Password</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="assets_with_creds" t-as="asset">
                                        <t t-if="asset.password"
                                           t-set="_log1" t-value="asset._log_credential_action('reveal', 'password')"/>
                                        <tr t-if="asset.password">
                                            <td><span t-out="asset.name"/></td>
                                            <td><span t-out="asset.url or '-'"/></td>
                                            <td><span t-out="asset.login_email or '-'"/></td>
                                            <td><span t-out="asset.password" style="font-family:monospace;"/></td>
                                        </tr>
                                        <t t-if="asset.password2"
                                           t-set="_log2" t-value="asset._log_credential_action('reveal', 'password2')"/>
                                        <tr t-if="asset.password2">
                                            <td><span t-out="asset.name"/> <small class="text-muted">(secondary)</small></td>
                                            <td><span t-out="asset.url2 or '-'"/></td>
                                            <td><span t-out="asset.login_email2 or '-'"/></td>
                                            <td><span t-out="asset.password2" style="font-family:monospace;"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <p class="text-muted mt-4" style="font-size:11px;">
                            This reveal has been recorded in the Credential Access Log for each asset and
                            infrastructure profile shown above.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
