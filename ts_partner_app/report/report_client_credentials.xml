<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_client_credentials" model="ir.actions.report">
        <field name="name">Credentials</field>
        <field name="model">partner.asset</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ts_partner_app.report_client_credentials</field>
        <field name="binding_model_id" ref="model_partner_asset"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Client Credentials'</field>
        <field name="group_ids" eval="[(6, 0, [ref('group_partner_asset_manager')])]"/>
    </record>

    <template id="report_client_credentials">
        <t t-call="web.html_container">
            <t t-foreach="docs.mapped('partner_id')" t-as="partner">
                <t t-set="partner_assets" t-value="docs.filtered(lambda a: a.partner_id == partner)"/>
                <t t-set="infra" t-value="partner.env['partner.infrastructure'].search([('partner_id', '=', partner.id)], limit=1)"/>
                <t t-set="environments" t-value="partner.env['partner.environment'].search([('partner_id', '=', partner.id)])"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="alert alert-danger" role="alert">
                            <strong>Restricted document.</strong> Contains live credentials. Managers only —
                            do not forward or store outside a secure location.
                        </div>
                        <h2>Client Credentials</h2>
                        <h4 t-out="partner.name"/>
                        <p class="text-muted">
                            Generated on <span t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                            by <span t-out="env.user.name"/>
                        </p>

                        <!-- ================= Infrastructure Profile ================= -->
                        <t t-if="infra and infra.hosting_type == 'custom_server'">
                            <h3 class="mt-4">Infrastructure Profile</h3>
                            <table class="table table-sm mt-2">
                                <tr>
                                    <td style="width:220px;"><strong>Server SSH</strong></td>
                                    <td>
                                        <span t-out="'%s@%s:%s' % (infra.server_ssh_user or '-', infra.server_host or '-', infra.server_ssh_port or '-')"/>
                                    </td>
                                </tr>
                            </table>
                        </t>

                        <!-- ================= Odoo Environments ================= -->
                        <t t-foreach="environments" t-as="oenv">
                            <t t-if="oenv.password or oenv.password2 or oenv.odoo_login_password or oenv.github_token"
                               t-set="_log" t-value="oenv._log_credential_action('reveal', 'credentials_report')"/>
                            <h3 class="mt-4">Environment — <span t-out="oenv.name"/></h3>
                            <table class="table table-sm mt-2">
                                <tr t-if="oenv.url or oenv.login_email or oenv.password">
                                    <td style="width:220px;"><strong>Primary Login</strong></td>
                                    <td>
                                        <span t-out="oenv.url or '-'"/><br/>
                                        <span class="text-muted">User:</span> <span t-out="oenv.login_email or '-'"/><br/>
                                        <span class="text-muted">Password:</span>
                                        <span t-out="oenv.password or '-'" style="font-family:monospace;"/>
                                    </td>
                                </tr>
                                <tr t-if="oenv.url2 or oenv.login_email2 or oenv.password2">
                                    <td><strong>Secondary Login</strong></td>
                                    <td>
                                        <span t-out="oenv.url2 or '-'"/><br/>
                                        <span class="text-muted">User:</span> <span t-out="oenv.login_email2 or '-'"/><br/>
                                        <span class="text-muted">Password:</span>
                                        <span t-out="oenv.password2 or '-'" style="font-family:monospace;"/>
                                    </td>
                                </tr>
                                <tr t-if="oenv.odoo_login_url or oenv.odoo_login_email or oenv.odoo_login_password">
                                    <td><strong>Odoo Login</strong></td>
                                    <td>
                                        <span t-out="oenv.odoo_login_url or '-'"/><br/>
                                        <span class="text-muted">User:</span> <span t-out="oenv.odoo_login_email or '-'"/><br/>
                                        <span class="text-muted">Password:</span>
                                        <span t-out="oenv.odoo_login_password or '-'" style="font-family:monospace;"/>
                                    </td>
                                </tr>
                                <tr t-if="oenv.github_url or oenv.github_token">
                                    <td><strong>GitHub</strong></td>
                                    <td>
                                        <span t-out="oenv.github_url or '-'"/>
                                        (<span t-out="oenv.github_branch or 'main'"/>)<br/>
                                        <span class="text-muted">Access Token:</span>
                                        <span t-out="oenv.github_token or '-'" style="font-family:monospace;"/>
                                    </td>
                                </tr>
                            </table>
                        </t>
                        <div t-if="not infra and not environments" class="text-muted mt-3">
                            No Infrastructure Profile or Odoo environment configured for this client.
                        </div>

                        <p class="text-muted mt-4" style="font-size:11px;">
                            This reveal has been recorded in the Credential Access Log for each asset and
                            environment shown above.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
