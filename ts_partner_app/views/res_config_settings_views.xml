<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ts_partner_app</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Odoo Clients 360" string="Odoo Clients 360" name="ts_partner_app"
                     logo="/ts_partner_app/static/description/icon.png"
                     groups="ts_partner_app.group_partner_asset_manager">
                    <block title="Currency Conversion" name="ts_currency_conversion">
                        <setting id="ts_multi_currency_setting" string="Multi-Currencies"
                                 help="Allow prices in currencies other than the company currency.">
                            <field name="group_multi_currency"/>
                        </setting>
                        <setting id="ts_currency_rates_setting" string="Automatic Currency Rates"
                                 help="Fetch exchange rates from an external provider (ECB, etc.) so USD/EUR license costs convert to the local currency at the real rate.">
                            <field name="ts_currency_provider"/>
                            <div class="content-group mt16" invisible="not ts_currency_provider">
                                <div class="row">
                                    <label for="ts_currency_interval_unit" string="Sync" class="col-lg-3 o_light_label"/>
                                    <field name="ts_currency_interval_unit"/>
                                </div>
                                <div class="row" invisible="ts_currency_interval_unit == 'manually'">
                                    <label for="ts_currency_next_execution_date" string="Next Run" class="col-lg-3 o_light_label"/>
                                    <field name="ts_currency_next_execution_date"/>
                                </div>
                                <button name="action_ts_update_currency_rates" type="object" icon="fa-refresh"
                                        string="Update Rates Now" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_ts_partner_app_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'ts_partner_app'}</field>
    </record>

    <menuitem id="partner_asset_menu_settings"
              name="Settings"
              parent="partner_asset_menu_config"
              action="action_ts_partner_app_config_settings"
              groups="ts_partner_app.group_partner_asset_manager"
              sequence="1"/>

</odoo>
