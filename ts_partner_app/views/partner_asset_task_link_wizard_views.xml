<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_asset_task_link_wizard_view_form" model="ir.ui.view">
        <field name="name">partner.asset.task.link.wizard.form</field>
        <field name="model">partner.asset.task.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Link Existing Tasks">
                <field name="asset_id" invisible="1"/>
                <group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="project_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="only_unassigned"/>
                    </group>
                </group>
                <field name="task_ids" nolabel="1"
                       domain="['|', ('asset_id', '=', False), ('asset_id', '=', asset_id)] if only_unassigned else []">
                    <list>
                        <field name="name"/>
                        <field name="project_id"/>
                        <field name="stage_id"/>
                        <field name="partner_id" optional="hide"/>
                        <field name="user_ids" widget="many2many_avatar_user" optional="show"/>
                        <field name="date_deadline" optional="show"/>
                        <field name="asset_id" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button name="action_link" type="object"
                            string="Link Tasks" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
