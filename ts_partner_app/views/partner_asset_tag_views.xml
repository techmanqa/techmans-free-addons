<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_asset_tag_view_tree" model="ir.ui.view">
        <field name="name">partner.asset.tag.tree</field>
        <field name="model">partner.asset.tag</field>
        <field name="arch" type="xml">
            <list string="Client Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="partner_asset_tag_action" model="ir.actions.act_window">
        <field name="name">Client Tags</field>
        <field name="res_model">partner.asset.tag</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="partner_asset_menu_tags"
              name="Client Tags"
              parent="partner_asset_menu_config"
              action="partner_asset_tag_action"
              sequence="20"/>
</odoo>
