<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_asset_stage_view_tree" model="ir.ui.view">
        <field name="name">partner.asset.stage.tree</field>
        <field name="model">partner.asset.stage</field>
        <field name="arch" type="xml">
            <list string="Client Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="kanban_color_picker"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="partner_asset_stage_view_form" model="ir.ui.view">
        <field name="name">partner.asset.stage.form</field>
        <field name="model">partner.asset.stage</field>
        <field name="arch" type="xml">
            <form string="Client Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="fold"/>
                            <field name="color" widget="kanban_color_picker"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Describe the purpose of this stage..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_asset_stage_action" model="ir.actions.act_window">
        <field name="name">Client Stages</field>
        <field name="res_model">partner.asset.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your asset stages!
            </p>
            <p>
                Stages allow you to track the lifecycle of an asset (e.g. Running, To Renew, Closed).
            </p>
        </field>
    </record>
</odoo>
