<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_ts_partner_app" model="ir.ui.view">
        <field name="name">account.move.form.ts_partner_app</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="asset_id"
                       domain="[('partner_id', 'child_of', commercial_partner_id)] if commercial_partner_id else []"
                       options="{'no_create_edit': True}"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_ts_partner_app" model="ir.ui.view">
        <field name="name">account.move.search.ts_partner_app</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <search position="inside">
                <field name="asset_id"/>
                <filter string="Client Asset" name="groupby_asset" context="{'group_by': 'asset_id'}"/>
            </search>
        </field>
    </record>

</odoo>
