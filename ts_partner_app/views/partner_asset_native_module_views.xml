<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_asset_native_module_view_tree" model="ir.ui.view">
        <field name="name">partner.asset.native.module.tree</field>
        <field name="model">partner.asset.native.module</field>
        <field name="arch" type="xml">
            <list string="Native Odoo Apps" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="partner_asset_native_module_action" model="ir.actions.act_window">
        <field name="name">Native Odoo Apps</field>
        <field name="res_model">partner.asset.native.module</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a native Odoo app!
            </p>
            <p>
                This is the catalog offered on the asset's "Native Odoo Apps Used" field.
            </p>
        </field>
    </record>

    <menuitem id="partner_asset_menu_native_modules"
              name="Native Odoo Apps"
              parent="partner_asset_menu_config"
              action="partner_asset_native_module_action"
              sequence="25"/>
</odoo>
