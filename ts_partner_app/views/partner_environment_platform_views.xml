<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_environment_platform_view_list" model="ir.ui.view">
        <field name="name">partner.environment.platform.list</field>
        <field name="model">partner.environment.platform</field>
        <field name="arch" type="xml">
            <list string="Environment Platforms" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="show_infrastructure" string="Infrastructure link"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="partner_environment_platform_view_form" model="ir.ui.view">
        <field name="name">partner.environment.platform.form</field>
        <field name="model">partner.environment.platform</field>
        <field name="arch" type="xml">
            <form string="Environment Platform">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="kind"/>
                        <field name="show_infrastructure"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_environment_platform_action" model="ir.actions.act_window">
        <field name="name">Environment Platforms</field>
        <field name="res_model">partner.environment.platform</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a hosting / packaging platform
            </p>
            <p>
                Odoo.sh, OEC.sh, Docker, ... The <b>Kind</b> decides which fields the
                environment form shows.
            </p>
        </field>
    </record>

    <menuitem id="partner_environment_platform_menu"
              name="Environment Platforms"
              parent="partner_asset_menu_config"
              action="partner_environment_platform_action"
              sequence="20"/>
</odoo>
