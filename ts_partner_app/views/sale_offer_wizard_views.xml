<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_offer_wizard_view_form" model="ir.ui.view">
        <field name="name">partner.sale.offer.wizard.form</field>
        <field name="model">partner.sale.offer.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Sale Offer">
                <field name="asset_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <field name="partner_id" readonly="1"/>
                </group>
                <p class="text-muted" invisible="line_ids">
                    No service products yet — go to Configuration &gt; Import Products first
                    to turn the Project Task Templates catalog into quotable services.
                </p>
                <field name="line_ids" nolabel="1" invisible="not line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="sequence" column_invisible="1"/>
                        <field name="template_task_id" column_invisible="1"/>
                        <field name="product_id" column_invisible="1"/>
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="phase"/>
                        <field name="name" readonly="1"/>
                        <field name="default_hours" readonly="1" optional="show"/>
                        <field name="quantity"/>
                        <field name="price_unit"/>
                    </list>
                </field>
                <group>
                    <group>
                        <field name="selected_count" string="Selected Services"/>
                        <field name="total_amount" widget="monetary"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_quotation" type="object"
                            string="Create Quotation" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_offer_wizard_action" model="ir.actions.act_window">
        <field name="name">Create Sale Offer</field>
        <field name="res_model">partner.sale.offer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
